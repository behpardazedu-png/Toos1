<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:layoutDirection="rtl">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">

        <EditText android:id="@+id/inputText" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minLines="4" android:gravity="top|start"
            android:hint="متن را بنویسید یا با میکروفن بگویید"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="8dp">
            <Button android:id="@+id/btnSpeak" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:text="🔊 خواندن متن"/>
            <Button android:id="@+id/btnListen" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:text="🎤 صوت به متن"/>
        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:text="پیامک‌ها" android:textSize="18sp"
            android:textStyle="bold"/>
        <Button android:id="@+id/btnLoadSms" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="نمایش پیامک‌های دریافتی"/>
        <ListView android:id="@+id/smsList" android:layout_width="match_parent"
            android:layout_height="260dp" android:nestedScrollingEnabled="true"/>
        <Button android:id="@+id/btnReadSms" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="🔊 خواندن پیامک انتخاب‌شده"/>
        <Button android:id="@+id/btnVoiceReply" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="🎤 پاسخ صوتی به فرستنده"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:text="ارسال پیامک به مخاطب" android:textSize="18sp"
            android:textStyle="bold"/>
        <Button android:id="@+id/btnPickContact" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="انتخاب مخاطب"/>
        <TextView android:id="@+id/contactLabel" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="مخاطبی انتخاب نشده"/>
        <Button android:id="@+id/btnSend" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="ارسال متن بالا به‌صورت پیامک"/>

        <Button android:id="@+id/btnCalls" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:text="نمایش سابقه تماس‌ها"/>
    </LinearLayout>
</ScrollView>
